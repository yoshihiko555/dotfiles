# ============================================
# Zsh Environment (loaded for all shells)
# ============================================

# dotfiles リポジトリの場所（各 zsh 設定から参照する）
export DOTFILES="${DOTFILES:-$HOME/ghq/github.com/yoshihiko555/dotfiles}"

# Homebrew (Apple Silicon)
# brew shellenv（zsh 版）の出力を直接書き、起動ごとの brew 実行を省く。
# PATH の先頭が既に brew なら何もしない判定も brew shellenv と同じ
if [[ -f /opt/homebrew/bin/brew && "$PATH:" != /opt/homebrew/bin:/opt/homebrew/sbin:* ]]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  fpath[1,0]="/opt/homebrew/share/zsh/site-functions"
  export FPATH
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
  [ -z "${MANPATH-}" ] || { export MANPATH="${MANPATH%"${MANPATH##*[!:]}"}"; export MANPATH=":${MANPATH#"${MANPATH%%[!:]*}"}"; }
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
fi

# mise (runtime version manager)
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# ユーザーローカルの実行ファイル（claude code の native install 等）
# 3 台共通。WSL2 は uv 未導入で ~/.local/bin/env が無く、
# .zshrc 末尾の source 頼みだと PATH に載らないためここで通す。
typeset -U path PATH
path=("$HOME/.local/bin" $path)

# fpath の重複排除。nix の /etc/zshenv がプロファイル階層ごとに同じ
# ディレクトリを積み上げるため（実測 43 件中ユニーク 21 件）、
# compinit がダンプを毎回「古い」と判定してフルリビルドしていた
# （zsh 対話起動 1.5s → 0.25s）。
typeset -U fpath
