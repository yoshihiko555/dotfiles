# ============================================
# Zsh Environment (loaded for all shells)
# ============================================

# dotfiles リポジトリの場所（各 zsh 設定から参照する）
export DOTFILES="${DOTFILES:-$HOME/ghq/github.com/yoshihiko555/dotfiles}"

# Homebrew (Apple Silicon)
# brew shellenv（zsh 版）の出力を直接書き、起動ごとの brew 実行を省く。
# PATH の先頭が既に brew なら何もしない判定も brew shellenv と同じ
if [[ -f /opt/homebrew/bin/brew && "$PATH:" != /opt/homebrew/bin:/opt/homebrew/sbin:* ]]; then
  export HOMEBREW_PREFIX="/opt/homebrew"
  export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
  export HOMEBREW_REPOSITORY="/opt/homebrew"
  fpath[1,0]="/opt/homebrew/share/zsh/site-functions"
  export FPATH
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}"
  [ -z "${MANPATH-}" ] || { export MANPATH="${MANPATH%"${MANPATH##*[!:]}"}"; export MANPATH=":${MANPATH#"${MANPATH%%[!:]*}"}"; }
  export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
fi

# mise (runtime version manager)
# activate の出力は mise の実体（Nix store のパス）ごとにキャッシュし、設定を変えたら作り直す。
# 冒頭の PATH 等を戻す行は生成時の環境を埋め込むため、フック定義以降だけを保存する
if command -v mise &>/dev/null; then
  _mise_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/mise-activate-${${commands[mise]:A:h:h}:t}.zsh
  if [[ ! -r $_mise_cache || ~/.config/mise/config.toml -nt $_mise_cache ]]; then
    mkdir -p ${_mise_cache:h}
    rm -f ${_mise_cache:h}/mise-activate-*.zsh(N)
    mise activate zsh | sed -n '/^autoload -Uz add-zsh-hook$/,$p' >| $_mise_cache.tmp
    if [[ -s $_mise_cache.tmp ]]; then
      mv -f $_mise_cache.tmp $_mise_cache
    else
      rm -f $_mise_cache.tmp
    fi
  fi
  if [[ -r $_mise_cache ]]; then
    source $_mise_cache
  else
    eval "$(mise activate zsh)"
  fi
  unset _mise_cache

  # Enter ごとの hook-env は直前に mise を実行したときだけにする（cd 時の切り替えは従来どおり）
  if (( $+functions[_mise_hook_precmd] )); then
    add-zsh-hook -d precmd _mise_hook_precmd
    _mise_preexec_mark() { [[ $1 == mise || $1 == mise\ * ]] && _mise_ran=1 }
    _mise_precmd_if_ran() { (( ${_mise_ran:-0} )) && { _mise_ran=0; _mise_hook --reason precmd; } }
    add-zsh-hook preexec _mise_preexec_mark
    add-zsh-hook precmd _mise_precmd_if_ran
  fi
fi

# ユーザーローカルの実行ファイル（claude code の native install 等）
# 3 台共通。WSL2 は uv 未導入で ~/.local/bin/env が無く、
# .zshrc 末尾の source 頼みだと PATH に載らないためここで通す。
typeset -U path PATH
path=("$HOME/.local/bin" $path)

# fpath の重複排除。nix の /etc/zshenv がプロファイル階層ごとに同じ
# ディレクトリを積み上げるため（実測 43 件中ユニーク 21 件）、
# compinit がダンプを毎回「古い」と判定してフルリビルドしていた
# （zsh 対話起動 1.5s → 0.25s）。
typeset -U fpath
