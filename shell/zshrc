# ============================================
# Zsh Configuration
# ============================================

# --------------------------------------------
# 1. Zsh Options
# --------------------------------------------
setopt AUTO_CD              # ディレクトリ名だけでcd
setopt AUTO_PUSHD           # cd時に自動でpushd
setopt PUSHD_IGNORE_DUPS    # pushdで重複を無視
setopt CORRECT              # コマンドのスペルミス訂正
setopt NO_BEEP              # ビープ音を無効化

# --------------------------------------------
# 2. History Settings
# --------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY     # 実行時刻と所要時間も保存する
setopt HIST_IGNORE_ALL_DUPS # 重複したコマンドは新しい方を残す
setopt HIST_REDUCE_BLANKS   # 履歴に保存する際に余分な空白を詰める
setopt HIST_IGNORE_SPACE    # スペース始まりは記録しない
setopt SHARE_HISTORY        # 複数ターミナルで履歴共有
setopt APPEND_HISTORY       # 履歴を追記

# ↑↓ は打った文字で始まる履歴だけをたどる（何も打っていなければ全履歴）
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# --------------------------------------------
# 3. Tool Initialization
# --------------------------------------------
# XON/XOFF フロー制御を無効化（Ctrl+Q を tmux Prefix として使うため）
stty -ixon

# mise は .zshenv で activate 済み
# sheldon (compinit を含む) を先にロード
# 生成スクリプトはキャッシュし、plugins.toml / plugins.lock か sheldon 本体が更新されたら作り直す
if command -v sheldon >/dev/null 2>&1; then
  _sheldon_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/sheldon-${${commands[sheldon]:A:h:h}:t}.zsh
  if [[ ! -r $_sheldon_cache ||
    ~/.config/sheldon/plugins.toml -nt $_sheldon_cache ||
    ~/.local/share/sheldon/plugins.lock -nt $_sheldon_cache ]]; then
    mkdir -p ${_sheldon_cache:h}
    if sheldon source >| $_sheldon_cache.tmp; then
      rm -f ${_sheldon_cache:h}/sheldon-*.zsh(N)
      mv -f $_sheldon_cache.tmp $_sheldon_cache
    else
      rm -f $_sheldon_cache.tmp
    fi
  fi
  [[ -r $_sheldon_cache ]] && source $_sheldon_cache
  unset _sheldon_cache
fi

# CLI が生成する補完関数。fpath に置き、遅延 compinit に読ませる。
# pnpm の補完は Tab のたびに pnpm completion-server へ問い合わせ、ファイル自体は版に依存しないため、無いときだけ作る。
# corepack の取得確認で起動が止まらないよう、ホームで確認なしに実行する
_comp_dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions
fpath=($_comp_dir $fpath)
# git は zsh 標準の _git を使う。Homebrew の git が入れる bash 由来の _git は候補をグループに分けない
_zsh_git=/usr/share/zsh/$ZSH_VERSION/functions/_git
if [[ -r $_zsh_git && ! $_comp_dir/_git -ef $_zsh_git ]]; then
  mkdir -p $_comp_dir && ln -sf $_zsh_git $_comp_dir/_git
fi
unset _zsh_git
if (( $+commands[pnpm] )) && [[ ! -s $_comp_dir/_pnpm ]]; then
  mkdir -p $_comp_dir
  if (cd ~ && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm completion zsh </dev/null) >| $_comp_dir/_pnpm.tmp 2>/dev/null &&
    [[ -s $_comp_dir/_pnpm.tmp ]]; then
    mv -f $_comp_dir/_pnpm.tmp $_comp_dir/_pnpm
  else
    rm -f $_comp_dir/_pnpm.tmp
  fi
fi
unset _comp_dir

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# init の出力は brew の版ごとにキャッシュし、起動のたびに bash を立ち上げない
if command -v git-gtr >/dev/null 2>&1; then
  _gtr_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/gtr-init-${${commands[git-gtr]:A:h:h}:t}.zsh
  if [[ ! -r $_gtr_cache ]]; then
    mkdir -p ${_gtr_cache:h}
    rm -f ${_gtr_cache:h}/gtr-init-*.zsh(N)
    git gtr init zsh >| $_gtr_cache.tmp && mv -f $_gtr_cache.tmp $_gtr_cache
  fi
  [[ -r $_gtr_cache ]] && source $_gtr_cache
  unset _gtr_cache
fi

# Starship prompt
# init の出力は starship の実体ごとにキャッシュする。init 内の PROMPT2 も starship を起動するため、
# 値を展開して保存し、starship.toml を変えたら作り直す
if command -v starship >/dev/null 2>&1; then
  export STARSHIP_CONFIG=~/.config/starship/starship.toml
  _starship_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship-init-${${commands[starship]:A:h:h}:t}.zsh
  if [[ ! -r $_starship_cache || $STARSHIP_CONFIG -nt $_starship_cache ]]; then
    mkdir -p ${_starship_cache:h}
    if {
      starship init zsh | grep -v '^PROMPT2='
      print -r -- "PROMPT2=${(qq)$(starship prompt --continuation)}"
    } >| $_starship_cache.tmp; then
      rm -f ${_starship_cache:h}/starship-init-*.zsh(N)
      mv -f $_starship_cache.tmp $_starship_cache
    else
      rm -f $_starship_cache.tmp
    fi
  fi
  [[ -r $_starship_cache ]] && source $_starship_cache
  unset _starship_cache
  # right_format 未使用なので、毎プロンプトの starship --right 呼び出しを止める
  RPROMPT=''
fi

# fzf tmux フローティング連携（display-popup で表示）
export BAT_THEME=TwoDark
export FZF_TMUX_OPTS="--tmux center,80%,60%"
export FZF_CTRL_T_OPTS='--tmux center,80%,60% --preview "sh ~/.zsh/fzf-preview.sh 100 {}"'
export FZF_ALT_C_OPTS="--tmux center,60%,40%"

# fzf のキーバインド（Ctrl-R 履歴 / Ctrl-T ファイル / Alt-C ディレクトリ）と ** の補完
# init の出力は fzf の実体ごとにキャッシュする。--zsh の無い古い fzf では何も読まない。
# fzf は ^I も bind するため、ここで同期に読み、遅延で読む fzf-tab に後から ^I を取らせる
# （fzf-tab は ^I を最後に bind し、元の widget を呼んで候補を集める）
if command -v fzf >/dev/null 2>&1; then
  _fzf_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/fzf-init-${${commands[fzf]:A:h:h}:t}.zsh
  if [[ ! -r $_fzf_cache ]]; then
    mkdir -p ${_fzf_cache:h}
    if fzf --zsh >| $_fzf_cache.tmp 2>/dev/null; then
      rm -f ${_fzf_cache:h}/fzf-init-*.zsh(N)
      mv -f $_fzf_cache.tmp $_fzf_cache
    else
      rm -f $_fzf_cache.tmp
    fi
  fi
  [[ -r $_fzf_cache ]] && source $_fzf_cache
  unset _fzf_cache
fi

# --------------------------------------------
# 4. Aliases & Functions
# --------------------------------------------
source ~/.zsh/aliases.zsh
source ~/.zsh/functions.zsh
source ~/.zsh/tmux.zsh
source ~/.zsh/docker.zsh
source ~/.zsh/wt.zsh
source ~/.zsh/repo.zsh
source ~/.zsh/trust.zsh
source ~/.zsh/cc-interrupt.zsh
source ~/.zsh/claude.zsh
source ~/.zsh/codex.zsh
source ~/.zsh/ccusage.zsh
source ~/.zsh/takt.zsh
source ~/.zsh/nix.zsh
source ~/.zsh/screenpipe.zsh
source ~/.zsh/awake.zsh
source ~/.zsh/herdr.zsh
source ~/.zsh/terminal-browser.zsh
source ~/.zsh/prompt-marks.zsh

# --------------------------------------------
# 5. Local Config (machine-specific)
# --------------------------------------------
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# bun completions
[ -s "/Users/yoshihiko/.bun/_bun" ] && source "/Users/yoshihiko/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

