# CLIProxyAPI の openai-compatibility 用シークレット (サンプル)
#
#   cp shared/cliproxyapi/secrets.env.example ~/.config/cliproxyapi/secrets.env
#   chmod 600 ~/.config/cliproxyapi/secrets.env
#   # 値を埋めてから
#   task cliproxy-setup
#
# このファイルが無い場合、openai-compatibility ブロックは conf に追記されない。
# 値が空のプロバイダは個別にスキップされる。
# モデル一覧は秘匿値ではないので shared/cliproxyapi/*.tmpl 側で編集する。

# --- 汎用 OpenAI 互換プロバイダ (openai-compat.tmpl) ---
# プロバイダ名 (user-agent やログに出る識別子。例: openrouter / deepseek / groq)
OPENAI_COMPAT_NAME=

# OpenAI 互換エンドポイントの base URL (末尾の /v1 まで含める)
OPENAI_COMPAT_BASE_URL=

# API キー
OPENAI_COMPAT_API_KEY=

# --- OpenCode Go (opencode-go.tmpl) ---
# OpenCode Console (https://opencode.ai/auth) で Go 契約後に表示される API キー。
# base URL はテンプレート側に固定 (https://opencode.ai/zen/go/v1)。
OPENCODE_GO_API_KEY=
