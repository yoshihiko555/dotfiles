{
  "env": {
    "CLAUDE_CODE_SHELL": "bash",
    "AI_ORCHESTRA_DIR": "/Users/yoshihiko/ghq/github.com/yoshihiko555/ai-orchestra",
    "CLAUDE_AFK_TIMEOUT_MS": "3600000",
    "NODE_OPTIONS": "--use-env-proxy",
    "AI_ORCHESTRA_PYTHON": "/Users/yoshihiko/.local/share/mise/installs/python/latest/bin/python3"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Search",
      "Glob",
      "Grep",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(git *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(codex *)",
      "Bash(gemini *)",
      "Bash(agy *)",
      "WebFetch(domain:api.github.com)",
      "mcp__pencil"
    ],
    "additionalDirectories": [
      "/tmp/claude-501",
      "/private/tmp/claude-501"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-work/hooks/check-settings-drift.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude-work/statusline.py"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "language": "日本語",
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "autoContinueAtUsageLimit": true,
  "model": "opus"
}
