				<string>#!/bin/zsh
# symlink 経由でも fmt.py を見つけられるよう、ワークフローディレクトリへ移動する。
cd "${alfred_preferences}/workflows/${alfred_workflow_uid}" 2&gt;/dev/null || true

set -uo pipefail

name="${1:-}"
if [[ -z "$name" ]]; then
  osascript -e 'display notification "変換が指定されていません" with title "Format"'
  exit 1
fi

# 候補列挙時ではなく実行時のクリップボードを対象にするため、ここで再変換する。
if ! result="$(/usr/bin/python3 ./fmt.py apply "$name" 2&gt;&amp;1)"; then
  osascript -e "display notification \"変換に失敗しました: $name\" with title \"Format\""
  exit 1
fi

printf '%s' "$result" | /usr/bin/pbcopy
osascript -e "display notification \"$name の結果をコピーしました\" with title \"Format\""
</string>
