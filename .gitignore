.DS_Store
*.swp
*.swo
*~
.env
.env.local
node_modules/
__pycache__/
*.pyc
.idea/
.vscode/
*.log
.nvimlog
.cache/

# Codex auto-generated system skills
codex/skills/.system
shared/skills/codex-only/.system/

# Local backups
backup/

# Karabiner auto backups
config/karabiner/automatic_backups/

# Git worktrees
.worktrees/

# TPM plugins (ランタイム依存、plugins.conf で自動インストール)
config/tmux/plugins/

# config-analyze が生成する解析キャッシュ（ローカル専用）
ANALYSIS.md

# takt のランタイム生成物（ログ・分析イベント）
takt/logs/
takt/analytics/
takt/runtime.yaml

# sops-nix: 暗号化前の平文秘匿ファイル（誤コミット防止、Phase 4-5）
# 暗号化後の *.yaml（ENC[...] のみ）は git 管理対象。平文は作業中のみ
# この命名で作り、暗号化後は必ず削除する
*.dec.yaml
*.plain.yaml
config/nix/secrets/*.dec.yaml
config/nix/secrets/*.plain.yaml

# nix build の出力 symlink（--no-link を付け忘れたときに生まれる）
/result
/result-*
