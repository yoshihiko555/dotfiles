[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
[core]
	autocrlf = input
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	line-numbers = true
	navigate = true
	syntax-theme = TwoDark
	# 漢字・かな（長音符を含む）は1文字ずつ比較し、他の単語は従来どおりまとめる。
	word-diff-regex = "[\\w--[\\p{scx:Han}\\p{scx:Hiragana}\\p{scx:Katakana}]]+"
	# 「January plan → February plan」程度の変更も同じ行として比較する。
	max-line-distance = 0.66
[gtr "worktrees"]
	dir = .worktrees
[gtr "editor"]
	default = zed

# 会社（Anvil）リポジトリの HTTPS URL を専用鍵の SSH エイリアスへ書き換える。
# ~/.ssh/config の Host github-anvil（IdentityFile ~/.ssh/github_anvil）を使う。
[url "ssh://git@github-anvil/Anvil-Co-Ltd/"]
	insteadOf = https://github.com/Anvil-Co-Ltd/

# dotfiles リポジトリ専用の設定（pre-commit フックの有効化）。
# 末尾のスラッシュにより、git worktree の gitdir（<repo>/.git/worktrees/*）も一致する。
[includeIf "gitdir:~/ghq/github.com/yoshihiko555/dotfiles/"]
	path = dotfiles.config
