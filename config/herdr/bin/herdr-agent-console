#!/usr/bin/env bash
# herdr-agent-console — 承認待ちエージェント・コンソール（prefix+b の popup）
#
# herdr 上のエージェント一覧を fzf で表示する（数秒ごとに自動更新、ヘッダーに状態別の件数）。
# 要対応(blocked)の行は画面を読み、承認ダイアログ / 質問フォーム / プラン承認を見分けて表示する。
#   j/k ↑↓ 移動 / c 次の完了へ / Enter ペインへ / a 承認 / d 拒否 / w 要対応のみ / r 再取得 / q 閉じる
#   /  検索モード（中では a/d/w/r/q/j/k/c は文字入力になる。Esc で通常モードへ戻る）
#
# 対象は常に pane_id（例: w1:p4）で指定する。agent 名は種別名（claude 等）で重複しうるため。
#
# 承認・拒否は確認なしで送る。代わりに次を満たすときだけ送り、結果は $SEND_LOG に残す。
#   1. 対象の状態が blocked（押した瞬間に herdr へ問い合わせ直す）
#   2. ツールの送信キーが分かっている（claude: 1 / esc、codex: y / esc、opencode: y / esc は未検証）
#   3. 承認のみ: ペインの表示が承認ダイアログ（1 番目の選択肢が Yes）である
# blocked は AskUserQuestion などの質問フォームやプラン承認でも立つ。そこへ a を送ると
# 1 番目の選択肢で回答してしまうため、一覧では「質問」「プラン」と表示し、a は送らない。

set -euo pipefail

# type = "shell" のデタッチ実行は PATH が最小で /opt/homebrew/bin が入らず、
# herdr / jq / fzf が見つからずに exit 127 になる。ここで補う。
# herdr 自身の場所は HERDR_BIN_PATH がペインに渡されていればそれを使う。
if [ -n "${HERDR_BIN_PATH:-}" ]; then
  PATH="$(dirname "$HERDR_BIN_PATH"):$PATH"
fi
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH


# popup で実行されると終了と同時に窓が閉じ、エラーが読めない。
# 異常終了の直前に必ず呼んで、ユーザーがメッセージを読めるようにする。
_pause_on_error() {
  echo >&2
  echo "Enter で閉じます" >&2
  read -r _ </dev/tty 2>/dev/null || true
}
trap '[ $? -ne 0 ] && _pause_on_error' EXIT


SELF="herdr-agent-console"
SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# a/d で送信した（またはスキップした）結果の記録先。
SEND_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-agent-console/actions.log"

err() {
  echo "$SELF: $*" >&2
}

usage() {
  cat <<'USAGE'
使い方: herdr-agent-console
  引数なしで実行すると fzf ベースの承認待ちエージェント・コンソールを開く。

  キー割当:
    j/k, ↑↓   移動（検索モード中は ↑↓ / Ctrl-j / Ctrl-k のみ）
    c         次の完了(done)の行へカーソルを移動（末尾まで行ったら先頭の完了へ戻る）
    Enter     選択エージェントのペインへフォーカスして終了
    a         承認キーを送信（確認プロンプトなし。承認ダイアログ以外はスキップ）
    d         拒否キー（Escape）を送信（blocked 以外はスキップ）
    /         検索モードに入り、文字入力で絞り込む
    Esc       検索モード中: 検索モードを終了（絞り込みは保持）
              通常モード  : 閉じる
    w         要対応(blocked)のみに絞り込む
    r         全件再取得（絞り込み・検索文字列を解除）
    q         閉じる（検索モード中は効かない。先に Esc で通常モードへ）

  送信結果は "~/.local/state/herdr-agent-console/actions.log"（$XDG_STATE_HOME 設定時はそちら）に記録される。
USAGE
}

# ---- 依存チェック ----
for cmd in herdr fzf; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    err "必要なコマンドが見つかりません: $cmd"
    exit 1
  fi
done

JSON_TOOL=""
if command -v jq >/dev/null 2>&1; then
  JSON_TOOL="jq"
elif command -v python3 >/dev/null 2>&1; then
  JSON_TOOL="python3"
else
  err "jq も python3 も見つかりません。どちらか一方が必要です。"
  exit 1
fi

# jq 版: herdr agent list の JSON を TSV に変換する
# 出力列: pane_id / kind / status / ws表示名 / タブ名 / title / cwd（ブランチ取得用の絶対パス）
# ws表示名は fetch_workspace_map の "番号:リポジトリ名"。マップに無ければ workspace_id を出す。
# タブ名は fetch_tab_map のラベル。マップに無ければ tab_id の "w3:" を落とした "t1" を出す。
# 色付けと列揃えは _PY の rows が行う。
json_to_tsv_jq() {
  local filter="$1" wsmap="${2:-}" tabmap="${3:-}"
  [ -z "$wsmap" ] && wsmap='{}'
  [ -z "$tabmap" ] && tabmap='{}'
  jq -r --arg filter "$filter" --argjson wsmap "$wsmap" --argjson tabmap "$tabmap" '
    def prio:
      if .agent_status=="blocked" then 0
      elif .agent_status=="working" then 1
      elif .agent_status=="unknown" then 2
      elif .agent_status=="idle" then 3
      elif .agent_status=="done" then 4
      else 5 end;
    (.result.agents // [])
    | map(select($filter != "blocked" or .agent_status == "blocked"))
    | map(. + {ws: ($wsmap[(.workspace_id // "")] // .workspace_id // "")})
    | sort_by(prio, .ws)
    | .[]
    | [
        (.pane_id // ""),
        (.agent // "?"),
        (.agent_status // "unknown"),
        .ws,
        ($tabmap[(.tab_id // "")] // ((.tab_id // "") | sub("^[^:]+:"; ""))),
        ((.terminal_title_stripped // .terminal_title // "") + (if .focused == true then " ★" else "" end)),
        (.foreground_cwd // .cwd // "")
      ]
    | @tsv
  '
}

# python3 版（jq が無い環境向けフォールバック）
json_to_tsv_py() {
  local filter="$1" wsmap="${2:-}" tabmap="${3:-}"
  [ -z "$wsmap" ] && wsmap='{}'
  [ -z "$tabmap" ] && tabmap='{}'
  python3 - "$filter" "$wsmap" "$tabmap" <<'PYEOF'
import json
import sys

filt, wsmap_raw, tabmap_raw = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    wsmap = json.loads(wsmap_raw)
except Exception:
    wsmap = {}
try:
    tabmap = json.loads(tabmap_raw)
except Exception:
    tabmap = {}
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

agents = ((data.get("result") or {}).get("agents")) or []

def prio(a):
    return {"blocked": 0, "working": 1, "unknown": 2, "idle": 3, "done": 4}.get(a.get("agent_status"), 5)

def ws_of(a):
    ws_id = a.get("workspace_id") or ""
    return wsmap.get(ws_id) or ws_id

if filt == "blocked":
    agents = [a for a in agents if a.get("agent_status") == "blocked"]

agents.sort(key=lambda a: (prio(a), ws_of(a)))

for a in agents:
    pane_id = a.get("pane_id") or ""
    kind = a.get("agent") or "?"
    status = a.get("agent_status") or "unknown"
    tab_id = a.get("tab_id") or ""
    tab = tabmap.get(tab_id) or (tab_id.split(":", 1)[1] if ":" in tab_id else tab_id)
    title = a.get("terminal_title_stripped") or a.get("terminal_title") or ""
    if a.get("focused"):
        title += " ★"
    cwd = a.get("foreground_cwd") or a.get("cwd") or ""
    row = [pane_id, kind, status, ws_of(a), tab, title, cwd]
    print("\t".join(row))
PYEOF
}

# jq 版: herdr agent list の生 JSON から件数を計算する。
# 出力: blocked \t working \t idle \t done \t other \t total の 1 行 TSV（常に全件が対象）
count_agents_jq() {
  jq -r '
    (.result.agents // []) as $a
    | ($a | length) as $total
    | ($a | map(select(.agent_status=="blocked")) | length) as $b
    | ($a | map(select(.agent_status=="working")) | length) as $w
    | ($a | map(select(.agent_status=="idle")) | length) as $i
    | ($a | map(select(.agent_status=="done")) | length) as $d
    | ($total - $b - $w - $i - $d) as $o
    | [$b, $w, $i, $d, $o, $total] | @tsv
  '
}

# python3 版件数カウント（フォールバック）
count_agents_py() {
  python3 - <<'PYEOF'
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    print("?\t?\t?\t?\t?\t?")
    sys.exit(0)

agents = ((data.get("result") or {}).get("agents")) or []

def c(s):
    return sum(1 for a in agents if a.get("agent_status") == s)

b, w, i, d = c("blocked"), c("working"), c("idle"), c("done")
total = len(agents)
o = total - b - w - i - d
print(f"{b}\t{w}\t{i}\t{d}\t{o}\t{total}")
PYEOF
}

# herdr agent list を叩いて生 JSON を返す。失敗時は stderr にエラーを出して
# 空文字列を返す（fzf の reload/transform から呼ばれても落ちないようにするため）。
fetch_agents_raw() {
  local tmp_err raw ec
  tmp_err="$(mktemp "${TMPDIR:-/tmp}/herdr-agent-console-err.XXXXXX")"
  if ! raw="$(herdr agent list 2>"$tmp_err")"; then
    ec=$?
    err "herdr agent list に失敗しました (exit=$ec): $(cat "$tmp_err")"
    rm -f "$tmp_err"
    return 0
  fi
  rm -f "$tmp_err"
  printf '%s' "$raw"
}

# herdr workspace list から「workspace_id → 表示名」のマップを JSON で返す。
# 表示名は herdr 本体の UI と同じ番号を前置した "番号:リポジトリ名"（例: "1:dotfiles"）。
# herdr は git リポジトリ配下で開いたワークスペースに repo 名の label を自動で付けるため、
# これで ws 列がリポジトリ名になる。取得に失敗した場合や label が無いワークスペースは
# マップに載せず、呼び出し側が従来どおり workspace_id を表示する。
fetch_workspace_map() {
  local raw
  if ! raw="$(herdr workspace list 2>/dev/null)" || [ -z "$raw" ]; then
    printf '{}'
    return 0
  fi
  if [ "$JSON_TOOL" = "jq" ]; then
    printf '%s' "$raw" | jq -c '
      [ (.result.workspaces // [])[]
        | select((.workspace_id // "") != "" and (.label // "") != "")
        | { key: .workspace_id,
            value: (if .number == null then .label
                    else ((.number | tostring) + ":" + .label) end) } ]
      | from_entries' 2>/dev/null || printf '{}'
  else
    printf '%s' "$raw" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("{}")
    sys.exit(0)
out = {}
for w in ((data.get("result") or {}).get("workspaces")) or []:
    wid = w.get("workspace_id") or ""
    label = w.get("label") or ""
    if not wid or not label:
        continue
    num = w.get("number")
    out[wid] = label if num is None else "%s:%s" % (num, label)
print(json.dumps(out))
' 2>/dev/null || printf '{}'
  fi
}

# herdr tab list から「tab_id → タブ名」のマップを JSON で返す。
# タブ名は herdr-automatic-rename が付けたラベル（例: "[1] claude"）。失敗時は空マップ。
fetch_tab_map() {
  local raw
  if ! raw="$(herdr tab list 2>/dev/null)" || [ -z "$raw" ]; then
    printf '{}'
    return 0
  fi
  if [ "$JSON_TOOL" = "jq" ]; then
    printf '%s' "$raw" | jq -c '
      [ (.result.tabs // [])[]
        | select((.tab_id // "") != "" and (.label // "") != "")
        | { key: .tab_id, value: .label } ]
      | from_entries' 2>/dev/null || printf '{}'
  else
    printf '%s' "$raw" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("{}")
    sys.exit(0)
out = {}
for t in ((data.get("result") or {}).get("tabs")) or []:
    if t.get("tab_id") and t.get("label"):
        out[t["tab_id"]] = t["label"]
print(json.dumps(out))
' 2>/dev/null || printf '{}'
  fi
}

# raw JSON から件数 TSV を計算し out_file に書き込む（_header が読む）。
write_counts() {
  local raw="$1" out_file="$2" line
  [ -z "$out_file" ] && return 0
  if [ -z "$raw" ]; then
    line=$'?\t?\t?\t?\t?\t?'
  elif [ "$JSON_TOOL" = "jq" ]; then
    line="$(printf '%s' "$raw" | count_agents_jq)"
  else
    line="$(printf '%s' "$raw" | count_agents_py)"
  fi
  [ -z "$line" ] && line=$'?\t?\t?\t?\t?\t?'
  printf '%s\n' "$line" >"$out_file" 2>/dev/null || true
}

# raw JSON から fzf に渡す行（pane_id / kind / status / 整形済み表示）を出す。
_rows_from_raw() {
  local raw="$1" filter="$2" wsmap tabmap
  wsmap="$(fetch_workspace_map)"
  tabmap="$(fetch_tab_map)"
  if [ "$JSON_TOOL" = "jq" ]; then
    printf '%s' "$raw" | json_to_tsv_jq "$filter" "$wsmap" "$tabmap" | _py rows || true
  else
    printf '%s' "$raw" | json_to_tsv_py "$filter" "$wsmap" "$tabmap" | _py rows || true
  fi
}

list_agents_tsv() {
  local filter="${1:-all}" raw
  raw="$(fetch_agents_raw)"
  [ -z "$raw" ] && return 0
  _rows_from_raw "$raw" "$filter"
}

pause_tty() {
  printf '\nEnter キーで一覧に戻ります...' >/dev/tty
  read -r _ </dev/tty || true
}

# ---- 隠しサブコマンド: fzf の reload / preview / bind から自分自身を呼び出す ----


# 表示の整形とダイアログ判定を行う Python。サブコマンド:
#   rows     json_to_tsv_* の TSV を読み、pane_id / kind / status / 整形済み表示 の 4 列を出す
#   header   rows と同じ列幅の列見出しを出す
#   classify ペインの表示テキストを読み、「種別<TAB>要約」を出す
#            種別: permission（承認ダイアログ）/ question（質問フォーム）/ plan / unknown
# 日本語は全角のためタブ区切りでは列が揃わない。表示用の列は 1 つのフィールドに詰めて
# 全角幅で揃え、fzf 側は --with-nth=4 で表示する。
# 色は config.toml の [ui.sidebar.agents] と揃える。SGR dim は透過背景に溶けるため使わない。
read -r -d '' _PY <<'PYEOF' || true
import re
import subprocess
import sys
import unicodedata

W_STATUS, W_TOOL, W_WS, W_BRANCH, W_TAB = 10, 9, 14, 12, 12

TEXT, SUB, OVERLAY = "#c8d3f5", "#828bb8", "#737aa2"
AGENT_COLOR = {"claude": "#CC7C5E", "codex": "#49A3B0", "agy": "#60BA7E", "opencode": "#3B82F6"}
# 表示キー: (ラベル, 色, 太字)。blocked は classify の結果で permission / question / plan に分ける
STATE = {
    "permission": ("● 承認", "#ff757f", True),
    "question": ("? 質問", "#c099ff", True),
    "plan": ("◇ プラン", "#c099ff", True),
    "blocked": ("● 待ち", "#ff757f", True),
    "working": ("◐ 作業中", "#ffc777", False),
    "idle": ("✓ 待機中", "#c3e88d", False),
    "done": ("✓ 完了", "#4fd6be", False),
}
UNKNOWN_STATE = ("? 不明", "#636da6", False)

OPT1 = re.compile(r"^\s*[❯›>]?\s*1\.\s")
YES1 = re.compile(r"^\s*[❯›>]?\s*1\.\s+Yes\b")
RULE = re.compile(r"^\s*[─━╌┄]{8,}\s*$")
BOX = "│╭╮╰╯─┌┐└┘├┤ "
ASK = ("Do you want", "Would you like")


def cw(c):
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def width(s):
    return sum(cw(c) for c in s)


def fit(s, w):
    """全角幅 w に切り詰め・右パディングする（列の間に最低 1 桁空ける）。"""
    if width(s) <= w - 1:
        return s + " " * (w - width(s))
    out, acc = "", 0
    for c in s:
        if acc + cw(c) > w - 2:
            break
        out += c
        acc += cw(c)
    return out + "‥" + " " * (w - acc - 1)


def color(s, hexc, bold=False):
    r, g, b = int(hexc[1:3], 16), int(hexc[3:5], 16), int(hexc[5:7], 16)
    return "\x1b[%s38;2;%d;%d;%dm%s\x1b[0m" % ("1;" if bold else "", r, g, b, s)


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        return ""


def classify(text):
    lines = [l.rstrip() for l in text.splitlines()]
    opts = [i for i, l in enumerate(lines) if OPT1.match(l)]
    if not opts:
        return "unknown", ""
    o = opts[-1]
    # ダイアログは罫線で始まる。見つからなければ直前 20 行を対象にする
    start = max(0, o - 20)
    for j in range(o - 1, start - 1, -1):
        if RULE.match(lines[j]):
            start = j + 1
            break
    flat = " ".join(l.strip() for l in lines[start:])
    above = [l.strip() for l in lines[start:o] if l.strip(BOX)]

    if any(k in flat for k in ("Chat about this", "Type something", "Enter to select")):
        q = [l for l in above if l[:1] not in "☐☒✔←→"]
        return "question", (q[-1] if q else "")
    if "written up a plan" in flat or "keep planning" in flat:
        return "plan", "プランの承認"
    if not YES1.match(lines[o]):
        return "unknown", ""

    # Codex: "$ コマンド" の行が承認対象
    cmd = next((l for l in reversed(above) if l.startswith("$ ")), None)
    if cmd:
        return "permission", cmd
    # Claude Code: 先頭行がツール名（Bash command / Edit file 等）、続く行が対象
    ask = next((l for l in above if l.startswith(ASK)), "")
    head = [l.strip(BOX) for l in above if not l.startswith(ASK)]
    if not head:
        return "permission", ask
    m = re.search(r"(?:make this edit to|create|delete this cell from) (.+?)\?$", ask)
    detail = m.group(1) if m else (head[1] if len(head) > 1 else "")
    return "permission", (head[0] + ": " + detail) if detail else head[0]


def branch_of(cwd, cache={}):
    if not cwd:
        return "-"
    if cwd not in cache:
        cache[cwd] = (run(["git", "-C", cwd, "branch", "--show-current"])
                      or run(["git", "-C", cwd, "rev-parse", "--short", "HEAD"])
                      or "-")
    return cache[cwd]


def rows():
    prev_ws = None
    for line in sys.stdin:
        f = line.rstrip("\n").split("\t")
        if len(f) < 7:
            continue
        pane, kind, status, ws, tab, title, cwd = f[:7]
        key, summary = status, ""
        if status == "blocked":
            screen = run(["herdr", "agent", "read", pane, "--source", "visible",
                          "--lines", "40", "--format", "text"])
            kind_of_dialog, summary = classify(screen)
            key = "blocked" if kind_of_dialog == "unknown" else kind_of_dialog
        label, scolor, sbold = STATE.get(key, UNKNOWN_STATE)
        # 待機中・完了は文字色を落として、見るべき行を目立たせる
        base = SUB if status in ("idle", "done") else TEXT
        cols = [
            color(fit(label, W_STATUS), scolor, sbold),
            color(fit(kind, W_TOOL), AGENT_COLOR.get(kind, base)),
            color(fit(ws, W_WS), OVERLAY if ws == prev_ws else base),
            color(fit(branch_of(cwd), W_BRANCH), SUB),
            color(fit(tab, W_TAB), SUB),
        ]
        if summary:
            cols.append(color(summary, TEXT, True) + "  " + color(title, OVERLAY))
        else:
            cols.append(color(title, base))
        prev_ws = ws
        print("\t".join([pane, kind, status, "".join(cols)]))


def header():
    names = ["状態", "tool", "ws", "branch", "tab"]
    widths = [W_STATUS, W_TOOL, W_WS, W_BRANCH, W_TAB]
    print("".join(fit(n, w) for n, w in zip(names, widths)) + "タイトル / 承認対象")


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "rows":
        rows()
    elif mode == "header":
        header()
    elif mode == "classify":
        print("%s\t%s" % classify(sys.stdin.read()))
PYEOF

_py() {
  python3 -c "$_PY" "$@"
}

cmd_list() {
  # $1: フィルタ状態を書いたファイルのパス（無ければ全件）
  local state_file="${1:-}" filter="all" raw
  if [ -n "$state_file" ] && [ -f "$state_file" ]; then
    filter="$(cat "$state_file" 2>/dev/null || echo all)"
  fi
  raw="$(fetch_agents_raw)"
  if [ -n "$state_file" ]; then
    write_counts "$raw" "${state_file}.counts"
  fi
  [ -z "$raw" ] && return 0
  _rows_from_raw "$raw" "$filter"
}

# ヘッダー（件数サマリ・絞り込み状態 + 列見出し）を出力する。fzf の transform-header から呼ばれる。
# 色は config.toml の [ui.sidebar.agents] の状態色と揃える。
cmd_header() {
  local state_file="${1:-}" filter="all"
  local query="${FZF_QUERY:-}"
  local b="?" w="?" i="?" d="?" o="?" t="?"
  if [ -n "$state_file" ] && [ -f "${state_file}.counts" ]; then
    IFS=$'\t' read -r b w i d o t <"${state_file}.counts" 2>/dev/null || true
  fi
  if [ -n "$state_file" ] && [ -f "$state_file" ]; then
    filter="$(cat "$state_file" 2>/dev/null || echo all)"
  fi
  local narrowed=""
  [ "$filter" = "blocked" ] && narrowed="要対応のみ"
  if [ -n "$query" ]; then
    narrowed="${narrowed:+$narrowed / }\"$query\""
  fi

  local counts_line
  counts_line="$(printf '\033[1;38;2;255;117;127m● 要対応 %s\033[0m   \033[38;2;255;199;119m◐ 作業中 %s\033[0m   \033[38;2;195;232;141m✓ 待機中 %s\033[0m   \033[38;2;79;214;190m✓ 完了 %s\033[0m' "$b" "$w" "$i" "$d")"
  if [ "$o" != "0" ] && [ "$o" != "?" ]; then
    counts_line="${counts_line}   $(printf '\033[38;2;99;109;166mその他 %s\033[0m' "$o")"
  fi
  if [ -n "$narrowed" ]; then
    counts_line="${counts_line}   $(printf '\033[38;2;255;199;119m絞り込み中: %s (r で解除)\033[0m' "$narrowed")"
  fi
  printf '%s\n' "$counts_line"
  # 背景が透過しているため暗いグレーは読めない。下線付きの通常色にする。
  printf '\033[4;38;2;200;211;245m%s\033[0m\n' "$(_py header)"
}

# フッター（キー操作の説明）を出力する。fzf の transform-footer から呼ばれる想定で、
# 実行中の fzf が渡す環境変数 FZF_INPUT_STATE を見て通常モード / 検索モードで内容を切り替える。
cmd_footer() {
  # キー名だけ herdr の accent 色にする
  local k=$'\033[38;2;130;170;255m' r=$'\033[0m'

  if [ "${FZF_INPUT_STATE:-hidden}" != "hidden" ]; then
    printf '検索モード: 文字入力で tool・ws・タイトル等を絞り込み\n'
    printf '%s↑↓ / Ctrl-j / Ctrl-k%s 移動   %sEnter%s フォーカス   %sEsc%s 検索終了（絞り込みは保持）\n' \
      "$k" "$r" "$k" "$r" "$k" "$r"
    return 0
  fi

  printf '%sj/k%s 移動   %sc%s 次の完了   %sEnter%s フォーカス   %sa%s 承認   %sd%s 拒否   %s/%s 検索\n' \
    "$k" "$r" "$k" "$r" "$k" "$r" "$k" "$r" "$k" "$r" "$k" "$r"
  printf '%sw%s 要対応のみ   %sr%s 再取得(絞り込み解除)   %sq%s 閉じる   (5秒ごとに自動更新)\n' \
    "$k" "$r" "$k" "$r" "$k" "$r"
}

# Esc が押されたときに呼ばれる。fzf の transform アクション用で、
# 実行すべきアクション列を標準出力に「1行」印字する。
#   検索モード中 (FZF_INPUT_STATE != hidden): 入力欄を隠し、キーを rebind し、
#     フッターを通常モードのものへ戻し、ヘッダーの絞り込み表示を更新する
#   通常モード   (FZF_INPUT_STATE == hidden): 何もせず abort（= 閉じる）
cmd_esc() {
  local state_file="${1:-}"
  if [ "${FZF_INPUT_STATE:-hidden}" = "hidden" ]; then
    echo abort
    return 0
  fi
  printf 'hide-input+rebind(j,k,a,d,w,r,q,c)+transform-footer("%s" _footer)+transform-header("%s" _header "%s")\n' \
    "$SCRIPT" "$SCRIPT" "$state_file"
}

# c が押されたときに呼ばれる。fzf の transform アクション用。
# $1 は表示中の行の状態列（{*f3}、表示順に 1 行ずつ）。カーソル位置 FZF_POS より下にある
# 最初の done へ pos(N) で移動し、無ければ先頭側の最初の done へ戻る。done が無ければ何もしない。
cmd_next_done() {
  local status_file="${1:-}" cur="${FZF_POS:-0}" n=0 first="" next="" st
  [ -n "$status_file" ] && [ -f "$status_file" ] || return 0
  while IFS= read -r st || [ -n "$st" ]; do
    n=$((n + 1))
    [ "$st" = "done" ] || continue
    [ -z "$first" ] && first="$n"
    if [ "$n" -gt "$cur" ]; then
      next="$n"
      break
    fi
  done <"$status_file"
  next="${next:-$first}"
  [ -n "$next" ] && printf 'pos(%s)\n' "$next"
  return 0
}

# 罫線だけの行を preview の幅に切り詰める。
# ペインの方が preview より広いと、罫線が折り返されて「↳ ────」の断片が出るため。
_fit_rules() {
  python3 -c '
import re, sys
w = int(sys.argv[1])
rule = re.compile(r"^[─-╿ ]+$")
for line in sys.stdin:
    line = line.rstrip("\n")
    print(line[:w] if rule.match(line) else line)
' "${FZF_PREVIEW_COLUMNS:-80}"
}

cmd_preview() {
  local pane_id="${1:-}" kind="${2:-}"
  if [ -z "$pane_id" ]; then
    echo "(pane_id が取得できませんでした)"
    return 0
  fi
  echo "pane   : $pane_id"
  echo "tool   : ${kind:-?}"
  echo "------------------------------------------------------------"
  if ! herdr agent read "$pane_id" --source visible --lines 60 --format text 2>&1 | _fit_rules; then
    echo "(herdr agent read に失敗しました。ペインが既に閉じている可能性があります)"
  fi
}

cmd_focus() {
  local pane_id="${1:-}"
  if [ -z "$pane_id" ]; then
    err "pane_id が指定されていません"
    exit 1
  fi
  if out="$(herdr agent focus "$pane_id" 2>&1)"; then
    echo "フォーカスしました: $pane_id"
  else
    err "フォーカスに失敗しました: $pane_id"
    echo "$out" >&2
    exit 1
  fi
}

# a / d 共通: 画面への結果表示 + ログ追記 + Enter 待ち
# $1=操作名(承認/拒否) $2=結果 $3=pane_id $4=kind $5=status $6=title $7=key(空可) $8=note
_report_and_log() {
  local action="$1" result="$2" pane_id="$3" kind="$4" status="$5" title="$6" key="$7" note="$8"

  # 画面には何も出さない（a/d を押すたびに完了画面が挟まると操作が止まるため）。
  # 何が起きたかは全てログに残す。結果は一覧の状態表示が更新されることで分かる。
  mkdir -p "$(dirname "$SEND_LOG")" 2>/dev/null || true
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$action" "$result" "$pane_id" "$kind" "$status" "${key:--}" "$note" \
    >>"$SEND_LOG" 2>/dev/null || true
}


# 押した瞬間の状態を herdr へ問い合わせて返す（pane_id, kind, status, title をタブ区切り）。
# fzf のフィールド番号に頼ると --with-nth との組み合わせでずれる上、一覧は最大 5 秒古い。
# 送信の可否は必ずこの関数の結果で判断する。
_live_agent() {
  local pane_id="$1" json
  json=$(herdr agent list 2>/dev/null) || return 1
  printf '%s' "$json" | jq -r --arg p "$pane_id" '
    .result.agents[]? | select(.pane_id == $p)
    | [.pane_id, (.agent // "unknown"), (.agent_status // "unknown"), (.terminal_title_stripped // "")]
    | @tsv' | head -1
}

cmd_approve() {
  local pane_id="${1:-}" kind="unknown" status="unknown" title=""
  local key="" note="" live=""

  if [ -z "$pane_id" ]; then
    err "pane_id が指定されていません"
    exit 1
  fi

  # 一覧の値ではなく、押した瞬間の状態を herdr から取り直す
  if live=$(_live_agent "$pane_id") && [ -n "$live" ]; then
    IFS=$'\t' read -r _ kind status title <<<"$live"
  else
    status="not_found"
  fi

  if [ "$status" != "blocked" ]; then
    _report_and_log "承認" "スキップ(承認待ちではありません)" "$pane_id" "$kind" "$status" "$title" "" \
      "対象は承認待ち(blocked)ではないため送信しませんでした。状態は押した時点で herdr に問い合わせた実際の値です。"
    return 0
  fi

  # 質問フォームやプラン承認に '1' を送ると 1 番目の選択肢で回答してしまう。
  # 押した瞬間の画面を読み、承認ダイアログのときだけ送る。
  local dialog
  dialog="$(herdr agent read "$pane_id" --source visible --lines 40 --format text 2>/dev/null |
    _py classify | cut -f1)" || dialog="unknown"
  if [ "$dialog" != "permission" ]; then
    _report_and_log "承認" "スキップ(承認ダイアログではありません: ${dialog:-unknown})" "$pane_id" "$kind" "$status" "$title" "" \
      "画面が質問フォーム・プラン承認・判定不能のいずれかだったため送信しませんでした。Enter でペインへ移動して回答してください。"
    return 0
  fi

  case "$kind" in
    claude)
      key="1"
      note="[実機検証済み 2026-09-22] Claude Code の Bash 権限ダイアログは '1' が「Yes」で、送信すると即承認されコマンドが実行されます。★ただし blocked は AskUserQuestion 等の質問フォームでも立ち、その場合 '1' は「1 番目の選択肢を選んで送信」になります。右の preview でダイアログ本文を必ず確認してください。"
      ;;
    codex)
      key="y"
      note="[ドキュメントで確認済み] Codex CLI の承認プロンプトは「1. Yes, proceed (y)」と明記されています。"
      ;;
    opencode)
      key="y"
      note="[文書ベース/未検証] OpenCode は y/n で応答すると案内されていますが、バージョンや tui.json の設定次第で変わりえます。"
      ;;
    *)
      key=""
      note="ツール '$kind' の承認キーは未調査・未確認です。誤送信を避けるため何も送信しません。"
      ;;
  esac

  if [ -z "$key" ]; then
    _report_and_log "承認" "スキップ(未調査ツール)" "$pane_id" "$kind" "$status" "$title" "" "$note"
    return 0
  fi

  local result="送信失敗" send_out=""
  if send_out="$(herdr agent send-keys "$pane_id" "$key" 2>&1)"; then
    result="送信成功"
  else
    result="送信失敗: ${send_out:-不明なエラー}"
  fi
  _report_and_log "承認" "$result" "$pane_id" "$kind" "$status" "$title" "$key" "$note"
}

cmd_deny() {
  local pane_id="${1:-}" kind="unknown" status="unknown" title=""
  local key="" note="" live=""

  if [ -z "$pane_id" ]; then
    err "pane_id が指定されていません"
    exit 1
  fi

  # 一覧の値ではなく、押した瞬間の状態を herdr から取り直す
  if live=$(_live_agent "$pane_id") && [ -n "$live" ]; then
    IFS=$'\t' read -r _ kind status title <<<"$live"
  else
    status="not_found"
  fi

  if [ "$status" != "blocked" ]; then
    _report_and_log "拒否" "スキップ(承認待ちではありません)" "$pane_id" "$kind" "$status" "$title" "" \
      "対象は承認待ち(blocked)ではないため送信しませんでした。状態は押した時点で herdr に問い合わせた実際の値です。"
    return 0
  fi

  case "$kind" in
    claude)
      key="esc"
      note="[実機検証済み 2026-09-22] Claude Code の Bash 権限ダイアログは Escape でキャンセルでき、コマンドは実行されず idle に戻ることを確認済みです。"
      ;;
    codex)
      key="esc"
      note="[ドキュメントで確認済み] Codex CLI の承認プロンプトには「3. No, and tell Codex what to do differently (esc)」と明記されています。"
      ;;
    opencode)
      key="esc"
      note="[文書ベース/未検証] OpenCode も Escape で拒否できると見られますが、未検証です。"
      ;;
    *)
      key=""
      note="ツール '$kind' の拒否キーは未調査・未確認です。誤送信を避けるため何も送信しません。"
      ;;
  esac

  if [ -z "$key" ]; then
    _report_and_log "拒否" "スキップ(未調査ツール)" "$pane_id" "$kind" "$status" "$title" "" "$note"
    return 0
  fi

  local result="送信失敗" send_out=""
  if send_out="$(herdr agent send-keys "$pane_id" "$key" 2>&1)"; then
    result="送信成功"
  else
    result="送信失敗: ${send_out:-不明なエラー}"
  fi
  _report_and_log "拒否" "$result" "$pane_id" "$kind" "$status" "$title" "$key" "$note"
}

# ---- メイン TUI ----

main_tui() {
  # herdr サーバーに疎通できるか事前確認（読み取りのみ）
  if ! herdr agent list >/dev/null 2>&1; then
    err "herdr agent list に疎通できませんでした。herdr サーバーが起動しているか確認してください。"
    exit 1
  fi

  local state_file
  state_file="$(mktemp "${TMPDIR:-/tmp}/herdr-agent-console-filter.XXXXXX")"
  echo all >"$state_file"
  trap 'rm -f "$state_file" "${state_file}.counts"' EXIT INT TERM

  local initial_list initial_header initial_footer
  initial_list="$(cmd_list "$state_file")"
  # 起動元の環境に FZF_INPUT_STATE / FZF_QUERY が漏れ込んでいても（例えば
  # herdr-cheatsheet など別の fzf 上でこのスクリプトを叩いた場合）、初期表示は
  # 必ず通常モードの表示になるよう明示的に固定する。
  initial_header="$(FZF_QUERY='' cmd_header "$state_file")"
  initial_footer="$(FZF_INPUT_STATE=hidden cmd_footer)"

  local preview_cmd focus_bind approve_bind deny_bind search_bind esc_bind w_bind r_bind c_bind every_bind refresh
  preview_cmd="\"$SCRIPT\" _preview {1} {2}"
  # 件数・絞り込み状態（ヘッダー）の更新
  refresh="transform-header(\"$SCRIPT\" _header \"$state_file\")"
  focus_bind="enter:become(\"$SCRIPT\" _focus {1})"
  approve_bind="a:execute-silent(\"$SCRIPT\" _approve {1})+reload-sync(\"$SCRIPT\" _list \"$state_file\")+$refresh"
  deny_bind="d:execute-silent(\"$SCRIPT\" _deny {1})+reload-sync(\"$SCRIPT\" _list \"$state_file\")+$refresh"
  # show-input で入力欄を出した後に transform-footer を呼ぶことで、
  # cmd_footer が FZF_INPUT_STATE の更新後の値を見て検索モード用の文言を返す
  # （esc_bind と同じ「show-input/hide-input を先に実行してから transform-footer
  # で読む」という順序に統一している）。
  search_bind="/:show-input+unbind(j,k,a,d,w,r,q,c)+transform-footer(\"$SCRIPT\" _footer)"
  esc_bind="esc:transform(\"$SCRIPT\" _esc \"$state_file\")"
  # reload（非同期）の後ろに繋いだアクションは実行されないため、ヘッダー更新を先に置く
  w_bind="w:execute-silent(echo blocked > \"$state_file\")+$refresh+reload(\"$SCRIPT\" _list \"$state_file\")"
  # 入力欄が隠れている間は clear-query が効かないため、一瞬だけ出して消す
  r_bind="r:execute-silent(echo all > \"$state_file\")+show-input+clear-query+hide-input+$refresh+reload(\"$SCRIPT\" _list \"$state_file\")"
  c_bind="c:transform(\"$SCRIPT\" _next_done {*f3})"
  every_bind="every(5):reload-sync(\"$SCRIPT\" _list \"$state_file\")+$refresh"

  # 一覧は枠で囲み、件数・列見出し（header）とキー説明（footer）を枠の中に埋め込む。
  # 色は herdr のテーマ（Tokyo Night Moon と [ui] accent）に揃える。
  # preview は follow で末尾から表示する（承認ダイアログは画面の最下部に出るため）。
  # ~N でヘッダ行を固定すると follow が効かなくなるので併用しない。
  printf '%s' "$initial_list" | fzf \
    --ansi \
    --no-input \
    --track \
    --id-nth=1 \
    --delimiter=$'\t' \
    --with-nth=4 \
    --layout=reverse \
    --highlight-line \
    --gutter=' ' \
    --list-border=rounded \
    --list-label=' エージェント ' \
    --header="$initial_header" \
    --header-border=inline \
    --footer="$initial_footer" \
    --footer-border=inline \
    --color='fg:#c8d3f5,fg+:#c8d3f5,bg+:#2f334d,gutter:-1,border:#545c7e,label:#82aaff,header:#c8d3f5,footer:#828bb8,pointer:#82aaff' \
    --preview="$preview_cmd" \
    --preview-window='right:55%:wrap:follow' \
    --bind 'j:down' \
    --bind 'k:up' \
    --bind 'q:abort' \
    --bind "$every_bind" \
    --bind "$w_bind" \
    --bind "$r_bind" \
    --bind "$c_bind" \
    --bind "$focus_bind" \
    --bind "$approve_bind" \
    --bind "$deny_bind" \
    --bind "$search_bind" \
    --bind "$esc_bind" \
    >/dev/null
}

main() {
  case "${1:-}" in
    _list)
      shift
      cmd_list "$@"
      ;;
    _header)
      shift
      cmd_header "$@"
      ;;
    _footer)
      shift
      cmd_footer "$@"
      ;;
    _esc)
      shift
      cmd_esc "$@"
      ;;
    _next_done)
      shift
      cmd_next_done "$@"
      ;;
    _preview)
      shift
      cmd_preview "$@"
      ;;
    _focus)
      shift
      cmd_focus "$@"
      ;;
    _approve)
      shift
      cmd_approve "$@"
      ;;
    _deny)
      shift
      cmd_deny "$@"
      ;;
    -h | --help)
      usage
      ;;
    "")
      main_tui
      ;;
    *)
      err "不明な引数です: $1"
      usage
      exit 1
      ;;
  esac
}

main "$@"
