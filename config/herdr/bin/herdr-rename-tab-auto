#!/usr/bin/env bash
# herdr-rename-tab-auto — 全タブの名前を、そこで動いているプロセス名に付け直す
#
# herdr にはタブ名の自動追従が無い（tmux の automatic-rename-format 相当が無い）。
# 連番のままだと何が開いているか分からないので、キー 1 つで全タブを更新する。
#
# プロセスの特定方法:
#   herdr pane process-info の foreground_processes は、エージェントのペインで
#   MCP サーバー等の子プロセスが並ぶ複数要素の配列になる。そのうち
#   pid == foreground_process_group_id のものがフォアグラウンドのリーダーで、
#   tmux の #{pane_current_command} に相当する（実データで検証済み）。
#
# 名前の作り方: タブ内の全ペインのリーダープロセス名を集め、シェルだけのペインは
# 除いて重複を畳んで並べる。全部シェルなら作業ディレクトリの末尾を使う。
#
# herdr のスクリプトは 3 つの制約に従う（詳細は herdr-init-panes 冒頭）:
#   PATH が引き継がれない / エラーが見えない / bash 3.2 なので mapfile が使えない
set -euo pipefail

if [ -n "${HERDR_BIN_PATH:-}" ]; then
  PATH="$(dirname "$HERDR_BIN_PATH"):$PATH"
fi
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

_notify() {
  herdr notification show "herdr-rename-tab-auto" --body "$1" >/dev/null 2>&1 || true
}
trap 'rc=$?; [ $rc -ne 0 ] && _notify "タブ名の更新に失敗しました (exit=$rc)"' EXIT

for cmd in herdr jq; do
  command -v "$cmd" >/dev/null 2>&1 || { _notify "必要なコマンドが見つかりません: $cmd"; exit 1; }
done

SHELLS='^(bash|zsh|fish|sh|dash|login)$'

# そのペインのリーダープロセス名を返す（シェルなら空）
leader_of() {
  herdr pane process-info --pane "$1" 2>/dev/null | jq -r --arg sh "$SHELLS" '
    .result.process_info as $i
    | [$i.foreground_processes[]? | select(.pid == $i.foreground_process_group_id) | .name]
    | first // ""
    | if test($sh) then "" else . end
  ' 2>/dev/null || true
}

# tab list には panes が含まれないため、pane list から tab_id 単位でまとめる。
panes_json=$(herdr pane list 2>/dev/null) || { _notify "pane list に失敗しました"; exit 1; }

renamed=0
while IFS= read -r tab_id; do
  [ -n "$tab_id" ] || continue

  names=""
  while IFS= read -r pane_id; do
    [ -n "$pane_id" ] || continue
    n=$(leader_of "$pane_id")
    [ -n "$n" ] || continue
    case " $names " in
      *" $n "*) ;;                      # 既にある名前は足さない
      *) names="${names:+$names }$n" ;;
    esac
  done < <(printf '%s' "$panes_json" | jq -r --arg t "$tab_id" '
      .result.panes[]? | select(.tab_id == $t) | .pane_id' 2>/dev/null)

  if [ -z "$names" ]; then
    # 全部シェルなら作業ディレクトリの末尾を使う
    cwd=$(printf '%s' "$panes_json" | jq -r --arg t "$tab_id" '
      [.result.panes[]? | select(.tab_id == $t) | .cwd] | first // empty' 2>/dev/null)
    [ -n "$cwd" ] && names="$(basename "$cwd")"
  fi

  [ -n "$names" ] || continue
  label=$(printf '%s' "$names" | tr ' ' '/')
  herdr tab rename "$tab_id" "$label" >/dev/null 2>&1 && renamed=$((renamed + 1))
done < <(printf '%s' "$panes_json" | jq -r '[.result.panes[]?.tab_id] | unique | .[]' 2>/dev/null)

[ "$renamed" -gt 0 ] || { _notify "更新対象のタブがありませんでした"; exit 1; }
