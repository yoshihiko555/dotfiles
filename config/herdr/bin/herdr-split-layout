#!/usr/bin/env bash
# herdr-split-layout — 現在のタブを N ペインに分割する（prefix+2..8）
#
# Usage: herdr-split-layout <N>
#
# herdr pane split --ratio は「分割元が残す比率」を指定する（tmux の -p とは逆。実測）。
# 分割はすべて --no-focus で行い、フォーカスは元のペインに残す。

set -euo pipefail

# type = "shell" のデタッチ実行は PATH が最小で /opt/homebrew/bin が入らず、
# herdr / jq / fzf が見つからずに exit 127 になる。ここで補う。
# herdr 自身の場所は HERDR_BIN_PATH がペインに渡されていればそれを使う。
if [ -n "${HERDR_BIN_PATH:-}" ]; then
  PATH="$(dirname "$HERDR_BIN_PATH"):$PATH"
fi
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH


# type = "shell" はデタッチ実行のため stderr がどこにも出ない。
# 失敗した理由が分からないと「押したのに何も起きない」になるので、
# 異常終了時は必ず herdr のトースト通知に出す。
_notify_fail() {
  herdr notification show "$(basename "$0")" --body "$1" >/dev/null 2>&1 || true
}
trap 'rc=$?; [ $rc -ne 0 ] && _notify_fail "失敗しました (exit=$rc)。詳細はペインで直接実行して確認してください。"' EXIT


N="${1:-}"

if [ -z "$N" ] || ! [[ "$N" =~ ^[0-9]+$ ]] || [ "$N" -lt 2 ] || [ "$N" -gt 8 ]; then
  herdr notification show "herdr-split-layout" --body "使い方: herdr-split-layout <2-8>" >/dev/null 2>&1 || true
  echo "herdr-split-layout: 使い方: herdr-split-layout <2-8>" >&2
  exit 1
fi

for cmd in herdr jq; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "herdr-split-layout: 必要なコマンドが見つかりません: $cmd" >&2
    exit 1
  fi
done

PANE_ID="${HERDR_PANE_ID:-}"
if [ -z "$PANE_ID" ]; then
  cur=$(herdr pane current --current 2>&1) || {
    echo "herdr-split-layout: 対象ペインを特定できませんでした: $cur" >&2
    exit 1
  }
  PANE_ID=$(printf '%s' "$cur" | jq -r '.result.pane.pane_id // empty')
fi
if [ -z "$PANE_ID" ]; then
  echo "herdr-split-layout: 対象ペインを特定できませんでした" >&2
  exit 1
fi

cur_pane=$(herdr pane current --pane "$PANE_ID" 2>&1) || {
  echo "herdr-split-layout: pane current に失敗しました: $cur_pane" >&2
  exit 1
}
CWD=$(printf '%s' "$cur_pane" | jq -r '.result.pane.cwd // empty')
if [ -z "$CWD" ]; then
  echo "herdr-split-layout: 対象ペインの cwd を取得できませんでした" >&2
  exit 1
fi

layout=$(herdr pane layout --pane "$PANE_ID" 2>&1) || {
  echo "herdr-split-layout: pane layout に失敗しました: $layout" >&2
  exit 1
}
pane_count=$(printf '%s' "$layout" | jq -r '.result.layout.panes | length')
if [ "$pane_count" -ne 1 ]; then
  echo "herdr-split-layout: 1ペインのタブでのみ実行できます (現在: ${pane_count}ペイン)" >&2
  exit 1
fi

split_pane() {
  local target="$1" direction="$2" ratio="$3"
  local out new_id
  out=$(herdr pane split --pane "$target" --direction "$direction" --ratio "$ratio" --cwd "$CWD" --no-focus 2>&1) || {
    echo "herdr-split-layout: pane split に失敗しました (target=${target} direction=${direction} ratio=${ratio}): ${out}" >&2
    exit 1
  }
  new_id=$(printf '%s' "$out" | jq -r '.result.pane.pane_id // empty')
  if [ -z "$new_id" ]; then
    echo "herdr-split-layout: pane split のレスポンスから pane_id を取得できませんでした: ${out}" >&2
    exit 1
  fi
  printf '%s\n' "$new_id"
}

case "$N" in
  # ┌──────┬──────┐
  # │  1   │  2   │
  # └──────┴──────┘
  2)
    split_pane "$PANE_ID" right 0.5 >/dev/null
    ;;

  # ┌──────┬──────┐
  # │      │  2   │
  # │  1   ├──────┤
  # │      │  3   │
  # └──────┴──────┘
  3)
    p2=$(split_pane "$PANE_ID" right 0.5)
    split_pane "$p2" down 0.5 >/dev/null
    ;;

  # ┌──────┬──────┐
  # │  1   │  2   │
  # ├──────┼──────┤
  # │  3   │  4   │
  # └──────┴──────┘
  4)
    p2=$(split_pane "$PANE_ID" right 0.5)
    split_pane "$PANE_ID" down 0.5 >/dev/null
    split_pane "$p2" down 0.5 >/dev/null
    ;;

  # ┌────────┬────────┐
  # │   1    │   2    │
  # ├─────┬──┴──┬─────┤
  # │  3  │  4  │  5  │
  # └─────┴─────┴─────┘
  5)
    p_bottom=$(split_pane "$PANE_ID" down 0.5)
    split_pane "$PANE_ID" right 0.5 >/dev/null
    p_br=$(split_pane "$p_bottom" right 0.33)
    split_pane "$p_br" right 0.5 >/dev/null
    ;;

  # ┌─────┬─────┬─────┐
  # │  1  │  2  │  3  │
  # ├─────┼─────┼─────┤
  # │  4  │  5  │  6  │
  # └─────┴─────┴─────┘
  6)
    p_bottom=$(split_pane "$PANE_ID" down 0.5)
    p_tr=$(split_pane "$PANE_ID" right 0.33)
    split_pane "$p_tr" right 0.5 >/dev/null
    p_br=$(split_pane "$p_bottom" right 0.33)
    split_pane "$p_br" right 0.5 >/dev/null
    ;;

  # ┌─────┬─────┬─────┐
  # │  1  │  2  │  3  │
  # ├───┬─┴──┬──┴─┬───┤
  # │ 4 │ 5  │ 6  │ 7 │
  # └───┴────┴────┴───┘
  7)
    p_bottom=$(split_pane "$PANE_ID" down 0.5)
    p_tr=$(split_pane "$PANE_ID" right 0.33)
    split_pane "$p_tr" right 0.5 >/dev/null
    p_br_half=$(split_pane "$p_bottom" right 0.5)
    split_pane "$p_bottom" right 0.5 >/dev/null
    split_pane "$p_br_half" right 0.5 >/dev/null
    ;;

  # ┌───┬───┬───┬───┐
  # │ 1 │ 2 │ 3 │ 4 │
  # ├───┼───┼───┼───┤
  # │ 5 │ 6 │ 7 │ 8 │
  # └───┴───┴───┴───┘
  8)
    p_bottom=$(split_pane "$PANE_ID" down 0.5)
    p_tr_half=$(split_pane "$PANE_ID" right 0.5)
    split_pane "$PANE_ID" right 0.5 >/dev/null
    split_pane "$p_tr_half" right 0.5 >/dev/null
    p_br_half=$(split_pane "$p_bottom" right 0.5)
    split_pane "$p_bottom" right 0.5 >/dev/null
    split_pane "$p_br_half" right 0.5 >/dev/null
    ;;
esac
